# ── Whitelist: track only .java and .bat files ──────────────────
# Ignore everything by default, then re-include directories plus
# the two file types we actually want in the repo.
*
!*/
!*.java
!*.bat
!.gitignore

# ── Hard-ignore these directories even if whitelisted above ─────
.git/
.claude/
.vscode/
.idea/
.venv/
venv/
bin/
out/
dist/
build/
_compiled_classes/
__pycache__/
.gradle/
.settings/
backup_before_renaming/
